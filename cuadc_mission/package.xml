<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cuadc_mission</name>
  <version>0.3.0</version>
  <description>CUADC 2026 多旋翼侦察与救援 · 任务状态机（M3：感知接入 + 目标锁定 + 两段对准 + 八门控投放；算法核心见 include/cuadc_mission/drop_logic.hpp，已验证参考实现见 tools/drop_logic.py）</description>
  <maintainer email="cuadc-team@users.noreply.github.com">CUADC Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mavros_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
