# CUAV Pixhawk V6X v2 + Jetson Orin Nano 竞赛配置（ArduPilot 版）
# 用途：多旋翼无人机侦察与救援（全自动 GUIDED 模式）
# 固件：V6X v2 板型为 CUAV-V6X-v2，ArduPilot 官方仅提供 beta 固件
#   https://firmware.ardupilot.org/Copter/beta/CUAV-V6X-v2/arducopter.apj
#   已验证版本 git dbe79216（存档于 设计/firmware/arducopter_beta_CUAV-V6X-v2.apj）
#   ⚠️ 此 beta 为新一代参数命名（SI 单位后缀）+ 懒加载参数组：
#     - WPNAV_SPEED → WP_SPD（单位 m/s），LAND_SPEED → LAND_SPD_MS，FS_GCS_ENABL → FS_GCS_ENABLE
#     - BATT_LOW → BATT_LOW_VOLT、BATT_CRT → BATT_CRT_VOLT（写不存在的旧名会被静默忽略）
#     - RNGFND1_*/PLND_TYPE 在功能开启并重启前不存在 → 参数需【导入两遍，中间重启】
#   ⚠️ 当前含 1 处临时值（各节有 ⚠️ 标注，验收后恢复）：
#     BRD_SAFETY_DEFLT（装机完成后恢复 1）
#     （EK3_RNG_USE_HGT=4 已于 09-24 激活持久化：卷尺四点比对通过——线性差 1.4cm/绝对 2.6~4.0cm；
#       RNGFND1_TYPE 同日定案 10=MAVLink 直收 MT-01P，14~24Hz 出数，均非临时值）
#   §5c GPS 段已按 09-25 单RTK CAN 终态实机审计改写（GPS1=X20P@CAN 四钥匙；GPS2 空口备用）
#   ⚠️ V6X v1 与 v2 载板通用但固件互不兼容，切勿刷 Pixhawk6X（v1）稳定版
# 导入方式：Mission Planner -> 配置/调试 -> 全参数树 -> 载入参数 -> 写入后重启 -> 再载入一遍 -> 再重启
# 注意：导入前先在原机上"保存参数到文件"做备份（已有 param_backup_*.param 可用）
# 串口映射（ArduPilot）：SERIAL0=USB  SERIAL1=TELEM1  SERIAL2=TELEM2  SERIAL4=GPS2  SERIAL5=TELEM3  SERIAL6=UART4

# ---------- 0. 机架（新固件默认 FRAME_CLASS=0 未定义，必须显式设置） ----------
FRAME_CLASS,1
FRAME_TYPE,1

# ---------- 0b. 电调输出（好盈 XRotor 40A，OPTO 无 BEC） ----------
# 输出刷新率：默认 490Hz 超出电调规格（50~450Hz），2026-09-09 真机已改 200
RC_SPEED,200
# 电机怠速三件套（⚠️ 必须成组，MOT_SPIN_ARM < MOT_SPIN_MIN 否则 PreArm
# "Motors: MOT_SPIN_ARM > MOT_SPIN_MIN" 拒绝解锁——2026-09-12 实机踩坑：
# 飞控上 MOT_SPIN_MIN 被改为 0.03 的孤儿值，解锁被拒；修复后验证解锁通过）
MOT_SPIN_MIN,0.15
MOT_SPIN_ARM,0.13
MOT_SPIN_MAX,0.95
MOT_THST_EXPO,0.65

# ---------- 1. 链路：TELEM1(SERIAL1) = MT-01P 激光定高【2026-09-24 晚定案，参数见 §5b】 ----------
# （本节不再单列 SERIAL1 参数行——§5b 是唯一定义；同日早间"空置封存 2/57"口径已被
#   MT-01P 接 TELEM1 的实测定案覆盖。历史：两对电台插本口曾"下行通上行死"，
#   09-24 翻案=口收路径健康（MT-01P 同口收数畅通），定性为电台内部速率与口波特率不匹配）
# UART4(SERIAL6) 还原禁用备用（插新设备前先改参数）
SERIAL6_PROTOCOL,-1
SERIAL6_BAUD,57
SERIAL6_OPTIONS,0

# ---------- 2. 链路：TELEM2 -> 数传电台 915（地面站）【2026-09-24 定案，数传占用原 Jetson 口】 ----------
# MAVLink2 + 9600（机载台串口速率；地面台 57600 各自独立）；线缆只有 TX/RX/GND 时必须关流控
# Jetson↔飞控已定案走 ETH 网口直连（见 §2b，2026-09-25 拍板）；USB /dev/cuadc-fc 降级为备份链路
SERIAL2_PROTOCOL,2
SERIAL2_BAUD,57
BRD_SER2_RTSCTS,0

# ---------- 2b. ETH 网口（Jetson 机载电脑直连；2026-09-25 定案，参数已落机回读全 PASS） ----------
# 拓扑：飞控 ETH(4Pin JST-GH) --网线--> Jetson enP8p1s0(192.168.144.15/24 静态，nmcli fc-eth)
# Jetson 侧 mavros：FCU_URL=udp://192.168.144.14:14550（飞控为 UDP 服务器，Jetson 主动发起）
# 修改 NET_* 后须重启生效；懒加载：NET_ENABLE=1 重启前其余 NET 参数不可见 → 需两遍导入
NET_ENABLE,1
NET_DHCP,0
NET_IPADDR0,192
NET_IPADDR1,168
NET_IPADDR2,144
NET_IPADDR3,14
NET_NETMASK,24
NET_P1_TYPE,2
NET_P1_PROTOCOL,2
NET_P1_PORT,14550

# ---------- 3. 失效保护（比赛全程禁止人工操纵，由机载状态机兜底） ----------
# 数传断链不动作：断链只影响"地面看数据"，不能让飞机自己乱飞
FS_GCS_ENABLE,0
# 遥控断链：当前值 5=RTL 是【地面调试期】的安全值；比赛上场前必须改回 0
# （比赛无人工操纵，由机载状态机兜底；改 0 后断链完全静默，务必赛前核对）
FS_THR_ENABLE,5

# ---------- 3b. 接收机（FS-i6 + FS-iA6B 走 PPM，2026-09-09 定案：比赛也用这套） ----------
# 原ELRS/CRSF+UART4(SERIAL6)方案作废：规则无接收机要求，任务区百米级 FS 链路够用，
# 省 ¥300+（省下的预算买反火花总开关，规则2.3"人工切断动力安全开关"载体）
# 接线：iA6B 的 PPM/CH1 → PPM IN 专用口（⚠️ 针序镜像：飞控中间针是信号，见 09-09 日志）
# 通道规划：
#   CH5 = 飞行模式（遥控器 SWC 三段对应：Stabilize/AltHold/Loiter）
#   CH6 = 急停（遥控器 SWA 两段对应；2026-09-25 按实物勘正：FS-i6 出厂 SWA 两挡、SWB/SWC 三挡，旧文 SWA/SWC 写反）
# 比赛上场 FS_THR_ENABLE 改 0（见 §3），CH6 急停拨杆即细则 5.8 的"紧急停止"
# ⚠️ 遥控器端 failsafe 必须设 No pulses（RX SETUP → FAILSAFE；出厂"保持"会掩盖断链）
RC6_OPTION,31
# FLTMODE_CH 固件默认即 5，2026-09-25 实机审计后显式化入账（防默认值变化翻车）
FLTMODE_CH,5
# 2026-09-11 已随基线导入并回读验证（两遍+重启+diff 全一致）；剩余动作只有遥控器端：
# SWC 拨杆分配到 CH5（三段模式）+ SWA 拨杆分配到 CH6（急停）+ iA6B failsafe 改 No pulses

# ---------- 4. 运动限制（新固件参数名，单位 m/s；旧 WPNAV_*/GUIDS_* 命名已废除） ----------
# 自动/GUIDED 巡航 4 m/s；上升 3 m/s；下降 1.5 m/s（旧名 WPNAV_SPEED,400 等）
WP_SPD,4
WP_SPD_UP,3
WP_SPD_DN,1.5
# 旧 GUIDS_SPEED/CLIMB/DESCEND/ANGLE 在新固件中不存在：
# GUIDED 位置目标速度由 WP_SPD 控制，倾斜限幅由 ATC_ANGLE_MAX 控制
# 最大倾斜 35°（⚠️ beta 固件此参数单位已改"度"：centidegrees 旧值 3500 会触发
# PreArm "must be >= 10 and <= 80"；2026-09-09 真机已改并回读对账）
ATC_ANGLE_MAX,35
# 降落速度 0.5 m/s（旧 LAND_SPEED,50；精准降落时 PLND 自行控制速度）
LAND_SPD_MS,0.5

# ---------- 5. EKF3 定位源（仅 GPS；换 VIO 时见下方注释） ----------
EK3_SRC1_POSXY,3
EK3_SRC1_POSZ,1
EK3_SRC1_VELXY,3
# 4m 以下激光辅助定高（方案 §3.2："EKF2_RNG_CTRL=1" 为 PX4 参数名，ArduPilot 对应此参数）
# 依赖下方 MT-01P（RNGFND1）已接通；前提 EK3_SRC1_POSZ=1（气压计为主，激光低空修正）
# 09-24 卷尺四点比对通过（线性差分 1.4cm / 绝对 2.6~4.0cm，恒定 -3cm 低偏归 GNDCLR），
# 已激活=4 并持久化（param_backup_20260924_231201 实证）；回读不为 4 时按此行写入
EK3_RNG_USE_HGT,4
# 用视觉里程计（VIO）时改为 ExternalNav 并核对 EK3_SRC 相关项：
# EK3_SRC1_POSXY,6
# EK3_SRC1_VELXY,6

# ---------- 5b. 微空 MT-01P 激光定高（接 TELEM1 = SERIAL1；09-24 实测定案） ----------
# MT-01P 出厂默认协议=MAVLink（官方文档：仅 Micolink/MAVLink/MSP 三种，无 TFmini），
# 即插即用无需微空助手；串口配方 09-24 实测定案 = PROTOCOL 1 + BAUD 115 + OPTIONS 0 + TYPE 10
# ⚠️ OPTIONS 必须为 0：bit0（值1，出厂默认）实测掐断该口 MAVLink 输入=模块零数据；
#    bit10（1024，微空文档的"禁转发"）曾被误写入实机（09-25 审计发现，激光虽仍出数但按官方
#    口径属 PreArm 拒绝值）——09-25 已写回 0 并重启持久化验证；禁转发由 MAV1_OPTIONS bit1 承担
# 09-20~09-23 的「TELEM3 + 切 TFmini + TYPE=20」方案前提有误，作废
# 09-24 实测：TELEM1 上 14~24Hz 稳定出数
SERIAL1_PROTOCOL,1
SERIAL1_BAUD,115
SERIAL1_OPTIONS,0
# MAVLink 实例 1（=SERIAL1）选项：bit1=NO_FORWARD、bit4=UNICAST——意图挡 MT-01P 双流转发，
# 但本 beta 两位实测均不生效（09-25/26 收官：=2 与 =18 洪水照旧），洪水治理改走模块侧降频；
# 位保留无害，实机维持=2
MAV1_OPTIONS,2
# 驱动：10=MAVLink（MT-01P 默认协议直收；20=TFmini 路线作废；25 才是 I2C 版勿混）
# 懒加载：RNGFND1_TYPE 写入并重启后，MIN/MAX/GNDCLR 等子参数才会出现 → 需第二遍导入
# （名字已实测确认：这版固件里 RNGFND1_MIN/MAX 沿用旧命名，单位 m）
RNGFND1_TYPE,10
# TELEM3(SERIAL5) 09-26 起为 Jetson Orin 40pin UART 主链（环回+外转验收全绿，判读链复活）：
# BAUD=921 即 921600（Jetson 历史口径）；流控关=杜邦线无 CTS/RTS，auto 档遇悬空会停 TX
SERIAL5_PROTOCOL,2
SERIAL5_BAUD,921
SERIAL5_OPTIONS,0
BRD_SER5_RTSCTS,0
RNGFND1_ORIENT,25
RNGFND1_MIN,0.3
RNGFND1_MAX,10
RNGFND1_SCALING,1
# 飞机着陆时传感器离地高度（按实际安装高度改）
RNGFND1_GNDCLR,0.1

# ---------- 5c. GPS/RTK（单RTK CAN 终态：GPS1=C-RTK 3 X20P@CAN；2026-09-22 拍板、09-23 四钥匙落机、09-25 实机审计入账） ----------
# 四钥匙：CAN_P1_DRIVER=1（§7b 已有）/ CAN_D1_PROTOCOL=1 / GPS1_TYPE=9 / GPS_AUTO_CONFIG=2
# 09-25 审计：飞控实值=9/2/1 全对，本文件曾滞后为旧配方（GPS1_TYPE,1）——已按实值改写，消除"全量导入打回空口"雷
# 2026-09-25 上网核验：CUAV 使用指南官方配方=GPS1_TYPE=9 + CAN_P1_DRIVER=1 + GPS_AUTO_CONFIG=2（"自动配置 DroneCAN GPS"，AP≥4.6 新名）——与本文件一致；官方另列 GPS1_POS_X/Y/Z（天线相对重心偏移，米，前/右/下为正）→ 装机实测后回填挂账
# 改正链：X20P 基站→笔记本 MP(RTK Inject)→915 数传(TELEM2)→FC→移动端 CAN（09-23 起切 CAN；见 04 册 §3）
# NEO-3 已拔除转台架备份；应急切换见 05 册「备用GPS_NEO3应急切换.md」（GPS1_TYPE 临时改 1）
GPS1_TYPE,9
GPS_AUTO_CONFIG,2
CAN_D1_PROTOCOL,1
GPS_AUTO_SWITCH,1
# 以下两行为 GPS2(SERIAL4) 空口备用口径：X20P 移 CAN 后此口无设备，TYPE=2 空跑无害
# （若恢复 X20P@UART 备用路线，改回 GPS1_TYPE=2/SERIAL4 口径并查 09-20 定案批）
GPS2_TYPE,2
SERIAL4_BAUD,230

# ---------- 6. 精准降落（Orin 发 LANDING_TARGET，飞控 PLND 模块执行） ----------
# ⚠️ 2026-09-14 勘误后口径：PLND_TYPE 0=Never / 1=CompanionComputer(MAVLink 收
#    LANDING_TARGET) / 2=IRLOCK——本项目用 1（与 SSOT §4.5 一致）
# 注意：飞控实机可能仍残留旧值 0（09-05 旧认知写入），下次连机 verify_params --diff
#    会报不一致，按本行写入 1 并回读；懒加载：PLND_ENABLED=1 写入并重启后 PLND_*
#    才出现在参数表 → 需第二遍导入
PLND_ENABLED,1
PLND_TYPE,1

# ---------- 7. 投放舵机（对应 PX4 AUX 输出） ----------
# V6X 带 IOMCU：AUX1/AUX2 口对应 SERVO9/SERVO10 参数（MAIN1/2 则是 SERVO1/2）
# 功能必须设 0（None），MAV_CMD_DO_SET_SERVO 才能直接控
# ArduPilot 舵机输出默认 50Hz；解锁前输出 SERVOx_TRIM=1500 保持中立
SERVO9_FUNCTION,0
SERVO10_FUNCTION,0

# ---------- 7b. 电池计（标配 CAN PMU lite，接 Power C1/C2，DroneCAN） ----------
# CUAV 手册要求三件套；缺了就没有电压/电流读数（P1-2 验收：读数误差 <5%）
# 注意：不能用 MP 的 Battery Monitor 设置向导（那是模拟电源模块用的）
BATT_MONITOR,8
CAN_P1_DRIVER,1
CAN_P2_DRIVER,1
# 实际电池 6S 8000mAh（2026-09-09 写入；原容量 3300 / 阈值 10.5V 均为 3S 默认值）
# 电池标签 22.2V 是"标称"电压，不是满电：满电 25.2(4.20V/c)、存储 ≈22.9、标称 22.2(3.7V/c)
# 三级电压：低电 21.6(3.6V/c) / 严重 21.0(3.5V/c) / 解锁门槛 22.5(3.75V/c)
# 解锁门槛取 22.5 的区间推理：
#   下限 = 低电阈值 21.6 + 悬停带载压降(6S 8000 约 0.6~1.0V) ≈ 22.5
#     —— 低于它解锁后一上负载就跌入低电区，起飞即触发低电失效保护
#   上限 ≈ 23.8 —— 再高短飞落地(静止 ~23.2-23.5)无法复飞（24.5 版教训）
#   22.5 介于标称与存储之间：存储态 22.92 可解锁；刚触发严重保护落地的电池
#   （静止回升 ~22.0-22.2）拒绝解锁，强制换电
# ⚠️ 真机当前仍写 24.5，下次连机改写 22.5 并回读核验（见 09-09 日志 §四）
BATT_CAPACITY,8000
BATT_LOW_VOLT,21.6
BATT_CRT_VOLT,21.0
BATT_ARM_VOLT,22.5
# 低电/严重低电的空中动作（2026-09-09 真机写入并回读；此前一直 0=只报不动作，
# 三级保护缺空中动作一半，见 09-09 日志）：低电 RTL(2)、严重 Land(1)
BATT_FS_LOW_ACT,2
BATT_FS_CRT_ACT,1

# ---------- 8. 日志 ----------
# 未解锁也记录，方便排查地面问题
LOG_DISARMED,1

# ---------- 9. 安全开关（⚠️ 临时） ----------
# 0=上电默认不启用安全锁：无 GPS 阶段便于未解锁电机测试（IO 输出口静默问题的
# 配套项，见 2026-09-09 日志 §五）；NEO-3 GPS 到货后恢复 1
BRD_SAFETY_DEFLT,0

# ---------- 重要差异提醒（PX4 -> ArduPilot） ----------
# 1. ArduPilot GUIDED 没有 PX4 的 offboard 断链失效保护（无 COM_OF_LOSS_T 等价物）：
#    速度 setpoint 断流后飞机会保持最后速度继续飞！状态机必须自带看护：
#    - 优先发位置 setpoint（断流=悬停原地），速度 setpoint 只短时使用
#    - Orin 侧监测状态机心跳，超时立即切位置保持并记录日志
# 2. 控制/导航模式用 GUIDED（对应 PX4 OFFBOARD），MAVROS 侧 apm.launch 接入
# 3. 起飞用 MAV_CMD_NAV_TAKEOFF，MAVROS /mavros/cmd/takeoff 服务
