# 【已弃用 2026-09-03】实际固件已改为 ArduPilot，请使用 V6X_ardupilot_params.param
# 本文件按 PX4 参数编写，导入 ArduPilot 固件会全部无法识别，仅留作对照
# CUAV Pixhawk V6X + Jetson Orin Nano 竞速配置
# 用途：多旋翼无人机侦察与救援（全自动 offboard）
# 导入方式：QGroundControl -> 载具设置 -> 参数 -> 工具 -> 载入文件
# 注意：导入前先在原机上 param save 备份；导入后需重启飞控

# ---------- 1. 链路：TELEM2 -> Orin Nano（ onboard 通道） ----------
1	1	MAV_1_CONFIG	102	6
1	1	MAV_1_MODE	2	6
1	1	MAV_1_RATE	0	6
1	1	MAV_1_FORWARD	0	6
1	1	SER_TEL2_BAUD	921600	6

# ---------- 2. 链路：TELEM1 -> 数传电台（地面站） ----------
1	1	MAV_0_CONFIG	101	6
1	1	MAV_0_MODE	0	6
1	1	MAV_0_RATE	1200	6

# ---------- 3. Offboard 与遥控器 ----------
# 4 = offboard 模式下丢遥控不触发失效保护
1	1	COM_RCL_EXCEPT	4	6
# offboard 断流：0=就地降落（比赛场地内最安全，不要设返航）
1	1	COM_OBL_ACT	0	6
1	1	COM_OBL_RC_ACT	4	6
1	1	COM_OF_LOSS_T	1.0	9
# 数据链路/遥控丢失不触发返航，由机载状态机自己兜底
1	1	NAV_DLL_ACT	0	6
1	1	NAV_RCL_ACT	0	6
# 4 = 禁用摇杆输入（杜绝误碰被判人工操纵，见规则 7.1.7）
# 调试阶段改回 0（仅遥控）或 3（遥控或摇杆）
1	1	COM_RC_IN_MODE	4	6

# ---------- 4. EKF / 定位 ----------
# EKF2_AID_MASK: bit0=GPS(1) bit1=光流(2) bit3=视觉位置(8)
# 仅 GPS 时填 1；装了光流模块改 3
1	1	EKF2_AID_MASK	1	6
# 高度源：0=气压计；低空可改 2=测距传感器（需装激光/超声波）
1	1	EKF2_HGT_MODE	0	6
1	1	EKF2_MAG_TYPE	0	6
# 用 VIO（如 VINS/ORB-SLAM）时把下面两行取消注释
#1	1	EKF2_EV_CTRL	15	6
#1	1	MAV_ODOM_LP	1	6

# ---------- 5. 飞行品质（平稳优先，别抖） ----------
1	1	MPC_XY_VEL_MAX	5.0	9
1	1	MPC_XY_CRUISE	4.0	9
1	1	MPC_Z_VEL_MAX_UP	3.0	9
1	1	MPC_Z_VEL_MAX_DN	1.5	9
1	1	MPC_TILTMAX_AIR	35.0	9
1	1	MPC_ACC_HOR	4.0	9
1	1	MPC_ACC_HOR_MAX	8.0	9
1	1	MPC_JERK_MAX	8.0	9
1	1	MPC_JERK_AUTO	4.0	9
1	1	MPC_LAND_SPEED	0.7	9

# ---------- 6. 投放舵机（AUX 输出） ----------
# AUX 通道做通用舵机用，50Hz
1	1	PWM_AUX_RATE	50	6
# 解锁状态下也要能动（地面调试投放机构用）
1	1	PWM_AUX_DISARM	1500	6
1	1	PWM_AUX_FAIL	1500	6
# 通道 1、2 设为"关闭功能"，交给 MAV_CMD_DO_SET_SERVO 直接控
1	1	PWM_AUX_FUNC1	0	6
1	1	PWM_AUX_FUNC2	0	6

# ---------- 7. 日志 ----------
1	1	SDLOG_MODE	2	6
1	1	SDLOG_PROFILE	131	6
